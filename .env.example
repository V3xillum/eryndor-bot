# Discord bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Application (Client) ID from the same portal → General Information
DISCORD_CLIENT_ID=

# Comma-separated Discord user snowflake IDs allowed to use admin weather commands
# Tip: enable Developer Mode in Discord (User Settings → Advanced), then right-click your user → Copy User ID
ALLOWED_USER_IDS=

# Random delay between automatic weather updates (minutes). Defaults: 360–1080 (6–18h).
# For local testing you can use e.g. 1 and 5.
# Per-guild override (no restart): /weather settings interval
WEATHER_UPDATE_MIN_MINUTES=360
WEATHER_UPDATE_MAX_MINUTES=1080

# Only run automatic updates inside this same-day window (timezone-aware).
# Manual /weather roll and /weather set still work outside the window.
# Set WEATHER_ACTIVE_WINDOW_ENABLED=false to allow 24/7 auto-updates.
# Per-guild override (no restart): /weather settings window — timezone always WEATHER_TIMEZONE
WEATHER_ACTIVE_WINDOW_ENABLED=true
WEATHER_ACTIVE_START=06:00
WEATHER_ACTIVE_END=23:00
WEATHER_TIMEZONE=Europe/Amsterdam

# Calendar of Eryndor static JSON API (public, no secrets).
# Used by /world today and /world fullmoon. DOY uses WEATHER_TIMEZONE (default Europe/Amsterdam).
ERYNDOR_CALENDAR_BASE_URL=https://v3xillum.github.io/eryndor
# Optional fallback when Pages returns 404
ERYNDOR_CALENDAR_FALLBACK_URL=https://raw.githubusercontent.com/V3xillum/eryndor/main
# Morning auto-post of /world today embed to the /world setup channel — only when events exist.
# Time is local in WEATHER_TIMEZONE. Restart required to change.
CALENDAR_EVENTS_POST_TIME=08:30
# Evening Full Moon (Rising) + exact Full Moon posts to the same channel (default 20:00).
CALENDAR_FULLMOON_POST_TIME=20:00

# DM handout (GitHub Pages). Shown by /weather help. Trailing slash optional.
HANDOUT_URL=https://v3xillum.github.io/eryndor-bot/handout/
